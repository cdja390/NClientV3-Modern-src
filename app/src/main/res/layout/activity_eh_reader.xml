<?xml version="1.0" encoding="utf-8"?>
<!-- NClientV3 Modern 4.7.2: e-hentai paging and continuous reading. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/eh_reader_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF000000">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF000000"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FF000000">
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/eh_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:saveEnabled="false"
            android:background="#FF000000" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/eh_webtoon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:saveEnabled="false"
            android:background="#FF000000"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/eh_reader_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/eh_reader_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="72dp"
            android:minHeight="40dp"
            android:gravity="center_vertical"
            android:contentDescription="@string/change_page"
            android:textColor="#FFFFFFFF" />

        <SeekBar
            android:id="@+id/eh_reader_seek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
