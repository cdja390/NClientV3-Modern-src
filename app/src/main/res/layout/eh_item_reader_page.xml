<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.maxwai.nclientv3.github.chrisbanes.photoview.PhotoView
        android:id="@+id/eh_page_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/eh_page_image" />

    <ProgressBar
        android:id="@+id/eh_page_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/eh_page_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="56dp"
        android:textColor="#99FFFFFF" />

    <TextView
        android:id="@+id/eh_page_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="32dp"
        android:textColor="#FFFFFFFF"
        android:visibility="gone" />
</FrameLayout>
